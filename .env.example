# Redis
REDIS_HOST=127.0.0.1
# compose publishes Redis on a random host port: `make deps` syncs this
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# Mailpit (filled by `make deps` / `make sync-env`)
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_URL=http://127.0.0.1:8025

# API
API_HOST=0.0.0.0
API_PORT=3000

# Mail account pool
MAIL_PROVIDERS_FILE=./config/mail-providers.yml

# Worker
WORKER_CONCURRENCY=3
# Global rate limit for the mail queue (across all worker processes)
WORKER_RATE_MAX=5
WORKER_RATE_DURATION_MS=1000
SHUTDOWN_GRACE_MS=20000
