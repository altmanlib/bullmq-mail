{
  "name": "bullmq-mail",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "biome check --write .",
    "api": "bun run src/main.ts",
    "worker": "bun run src/worker.ts",
    "build": "bun build src/main.ts src/worker.ts --target=bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "enqueue": "bun run scripts/enqueue-sample.ts"
  },
  "dependencies": {
    "bullmq": "^6.3.12",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "typescript": "6.0.3"
  }
}
